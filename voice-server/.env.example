# ─────────────────────────────────────────────────────────────
# 环境变量。由 scripts/init.sh 自动生成，一般不用手改。
# .env 已在 .gitignore 里，不要提交。
# ─────────────────────────────────────────────────────────────

# LiveKit 密钥对。
# ⚠️ 必须和 livekit/livekit.yaml 里 keys: 段完全一致，否则 token 校验失败。
#    init.sh 会同时写入这两处。
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-random-32-char-string

# 客户端连接用的信令地址（会写进 token 响应，方便客户端自动填充）
LIVEKIT_URL=ws://YOUR_SERVER_IP:7880

# 后端监听端口。
# 注意：不是 3000 —— 3000/3001 被这台机器上原有的 Haven 占用了。
PORT=3005

# 邀请码：客户端调 /api/token 时必须带上，防止陌生人白嫖你的带宽。
INVITE_CODE=change-me

# ─────────────────────────────────────────────────────────────
# 频道主的昵称（可选，但**强烈建议填**）
#
# 填了之后：谁用这个昵称连上服务器，谁就自动成为频道主 —— 跟本地身份无关。
# 于是清缓存、换电脑、重装服务器、甚至重建数据库，只要昵称对得上
# 就能自动拿回频道主，不用抢也不用跑 admin.js。
#
# ⚠️ 填了之后会**关闭"先到先得"**：其他人不会因为先连上就成为频道主。
#
# 留空则退回"先到先得"（第一个连上服务器的人成为频道主）—— 方便，
# 但容易被临时连接（比如浏览器测试页）抢先。
# 频道主是谁。**留空也能用** ✓ 但两种模式行为不同，先看清楚：
#
#   ▸ 填了名字（推荐 ✓ 结果确定）
#       第一个用**这个昵称**连上来的人成为频道主 ✓（大小写不敏感 ✓）
#       别人就算把昵称改成一样的 ✗ 也拿不到权限 ✓ 只会被改成中性名 ✓
#
#   ▸ 留空（先到先得 ✗ 结果看谁手快）
#       **第一个连上服务器的任何人**成为频道主 ✓
#       ⚠️ 容易被临时连接抢先 ✗（比如用 tools/test-page 试一下 ✓ 它就成频道主了 ✓）
#
# 改完要重启：sudo systemctl restart voice-backend
#
# ⚠️ 已经有人连过、而且频道主不是你 → 在服务器上指定：
#       node backend/src/fix-member.mjs list
#       node backend/src/fix-member.mjs promote <你的 userId>
OWNER_NAME=

# SQLite 数据库路径（宿主机上的绝对路径）
DB_PATH=/opt/voice-server/data/voice.db

# ─────────────────────────────────────────────────────────────
# 云端文件（聊天附件 + 文件共享）
#
# 文件本体存磁盘，元信息存数据库。默认放在数据库旁边的 uploads/，
# 这样备份只要拷一个目录。
UPLOADS_DIR=/opt/voice-server/data/uploads

# 单个文件大小上限（字节）。默认 100 MB = 104857600。
#
# ⚠️ 上传时文件会**整个读进内存**再落盘（不用 multipart，省一个依赖）。
#    所以真正的风险不是单个文件多大，而是**同时有几个上传**：
#    3 个人同时传 100 MB 就是 300 MB 内存。2 GB 内存的机器上这是安全的，
#    但别再往上加了。
#
# 另外下载会走公网出口流量，注意月度额度。
MAX_UPLOAD_BYTES=104857600
