# 国内网络下必须的配置，否则 npm install 会卡在下载 Electron 二进制上。
#
# Electron 的运行时不走 npm registry，而是从 GitHub Releases 下载，国内直连经常超时。
# npmmirror 提供了完整镜像。
#
# ⚠️ 关于下面两行会看到的警告：
#     npm warn Unknown project config "electron_mirror"
#   这是 npm 11 的提示 —— 它不认识这两个 key，但仍然会把它们作为
#   npm_config_electron_mirror 环境变量传给子进程，@electron/get 能读到，所以**能正常工作**。
#   npm 12 起会停止传递未知 key，到那时改用真正的环境变量：
#
#     $env:ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/"
#     $env:ELECTRON_BUILDER_BINARIES_MIRROR="https://npmmirror.com/mirrors/electron-builder-binaries/"
#
#   或者永久写进用户环境变量：
#     [Environment]::SetEnvironmentVariable('ELECTRON_MIRROR','https://npmmirror.com/mirrors/electron/','User')

registry=https://registry.npmmirror.com
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
